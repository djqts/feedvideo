# =============================================================================
# FeedVideo 环境变量模板（P0.2）
# 本文件只允许包含：变量名 + 格式/用途说明 + 占位符。
# 禁止把可用的生产凭据提交到仓库；生产环境请通过 Docker Secret /
# Kubernetes Secret / Secret Manager 注入，并保证 APP_ENV=production 时缺失即 fail-fast。
#
# 使用：
#   cp .env.example .env && 编辑 .env 填入真实值（生产必须强随机；本地开发可全部用示例值）
# =============================================================================

# 运行环境：development / production（缺省 production）
APP_ENV=production

# MySQL
# 必填。本地开发示例：dev-mysql-pass
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=feedvideo
MYSQL_USER=root

# MongoDB（启用认证）
# 必填。本地开发示例：dev-mongo-user / dev-mongo-pass
MONGO_INITDB_ROOT_USERNAME=change-me
MONGO_INITDB_ROOT_PASSWORD=change-me

# Redis（必填，启用 requirepass）
REDIS_PASSWORD=change-me

# RabbitMQ（必填）
RABBITMQ_DEFAULT_USER=change-me
RABBITMQ_DEFAULT_PASS=change-me

# MinIO（必填，至少 8 位）
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# JWT/RSA（必填）
# JWT_SECRET_KEY 用于 HMAC 派生/兼容性密钥；RSA 密钥对通过 Docker Secret
# 挂载到容器内，路径由 PRIVATE_KEY_PATH / PUBLIC_KEY_PATH 指定
JWT_SECRET_KEY=change-me
PRIVATE_KEY_PATH=/app/keys/private.pem
PUBLIC_KEY_PATH=/app/keys/public.pem

# 管理员 UID 白名单（逗号分隔）
ADMIN_IDS=26

# 生产 CORS 允许的来源（逗号分隔，必须为真实 HTTPS 前端域名）
# 示例：https://feedvideo.example.com
CORS_ALLOWED_ORIGINS=

# 桶名
VIDEO_BUCKET=feedvideo-videos
COVER_BUCKET=feedvideo-covers

# nginx 宿主端口（生产通常 80/443）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
